**/*.gguf
**/*.bin
**/*.pt
**/*.pth
models/
huggingface_cache/
.cache/
legacy_qwen27b_model/

# Docker volumes
docker/postgres/data/
pgdata/

# User's ingested source PDFs (large, user-specific)
data/pdfs/*
